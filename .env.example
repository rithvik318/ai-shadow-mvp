# Copy to backend/.env and fill in. Never commit the resulting file.

# --- Application ---------------------------------------------------------
APP_NAME=AI Shadow MVP
DEBUG=true

# --- Database ------------------------------------------------------------
# Matches the docker-compose service in the repository root.
DATABASE_URL=postgresql+psycopg2://aishadow:aishadow@localhost:5432/aishadow

# --- Document ingestion --------------------------------------------------
# Maximum accepted upload size, in bytes (default 10 MiB).
MAX_UPLOAD_SIZE_BYTES=10485760
# Target characters per chunk and overlap between neighbouring chunks.
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# --- Embeddings ----------------------------------------------------------
# The embedding column is created with this width. Changing it requires a
# migration, so it is configuration only in the sense of documenting intent.
EMBEDDING_DIMENSIONS=1536
# Must produce EMBEDDING_DIMENSIONS-wide vectors, or ingestion refuses to store
# them. openai/text-embedding-3-small is 1536.
EMBEDDING_MODEL=openai/text-embedding-3-small
# Leave unset to use LLM_PROVIDER. Set to `openai` to route embeddings to
# OpenAI while completions stay elsewhere — the fallback if the configured
# provider does not serve embeddings. Verify with:
#   cd backend && python -m scripts.verify_embedding_provider
EMBEDDING_PROVIDER=
# Texts per provider call during ingestion.
EMBEDDING_BATCH_SIZE=64

# --- Retrieval -----------------------------------------------------------
# Chunks returned per search, and the cosine-similarity floor each must clear.
# Similarity is cosine, so the floor is a number in [-1.0, 1.0]; 0.0 means
# "orthogonal or better", which excludes chunks pointing the opposite way but
# nothing else. Leave the value empty to disable filtering entirely. A useful
# floor can only be chosen against real documents; see docs/ROADMAP.md.
RETRIEVAL_TOP_K=5
RETRIEVAL_SIMILARITY_THRESHOLD=0.0

# --- LLM provider --------------------------------------------------------
# Not used by ingestion. Required once the retrieval/chat feature lands.
LLM_PROVIDER=openrouter
LLM_MODEL=openai/gpt-oss-20b
OPENAI_API_KEY=
OPENROUTER_API_KEY=
# Bounds on one model call, and on all the calls behind one activity report.
# The defaults are deliberate: the OpenAI SDK would otherwise wait ten minutes
# per call and retry twice, which a report multiplies by a dozen.
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=1
REPORT_ANALYSIS_BUDGET_SECONDS=90
# How long a stored activity report for the *current* week or month is served
# without rechecking the mailbox, and how long one generation may hold its
# claim before another request may take it over. A closed period is answered
# from storage forever.
ACTIVITY_REPORT_FRESH_SECONDS=1800
ACTIVITY_REPORT_LOCK_SECONDS=600

# --- OneDrive synchronisation --------------------------------------------
# Optional. Leave every value empty for a deployment that does not sync; the
# application imports and serves normally without them.
#
# Prerequisites, once, by a tenant administrator:
#   1. Register an application in Microsoft Entra ID.
#   2. Grant it the APPLICATION permission Files.Read.All. That is the whole
#      requirement for reading files: it covers files in all site collections,
#      SharePoint document libraries included. Sites.Read.All is a *different*
#      permission, needed only to discover sites through the /sites endpoints,
#      and this application does not use them.
#   3. Grant admin consent. Without it every Graph call returns 403.
#   4. Create a client secret and put it here. Never commit it.
#
# One application, three separate consents. These same three variables also
# authenticate the Email Agent and the calendar import, but the *permissions*
# do not carry over: mail needs Mail.Read and Mail.Send, and the calendar
# needs Calendars.Read. Files.Read.All grants none of them, so re-granting it
# after a mail or calendar 403 cannot help. GET /email/provider/status and
# GET /calendar/status each say which one is missing.
ONEDRIVE_TENANT_ID=
ONEDRIVE_CLIENT_ID=
ONEDRIVE_CLIENT_SECRET=

# The drive every source belongs to unless it names its own. Find it with:
#   GET /users/{user}/drive          (a person's OneDrive)
#   GET /sites/{site}/drives         (a SharePoint document library)
ONEDRIVE_DRIVE_ID=

# Which folders to synchronise, as a JSON array on one line. No folder is named
# anywhere in application code, so adding a sixth source is this line and a
# restart.
#
# Per entry:
#   key       required. Stable identity. Sync state, including the delta token,
#             is stored against it — renaming one forces a full resync.
#   label     optional. What a person sees. Defaults to the path.
#   drive_id  optional if ONEDRIVE_DRIVE_ID is set.
#   user      a person's address, for a folder in their OneDrive for Business.
#             Graph is asked for that person's drive, so no drive id has to be
#             pasted anywhere. A source naming a `user` never falls back to
#             ONEDRIVE_DRIVE_ID — addressing the wrong drive silently is worse
#             than failing to resolve.
#   path      the folder, relative to the **drive root**. A OneDrive web URL
#             reads /personal/<site>/Documents/Knowledge Base, but the drive
#             root *is* `Documents` — so the path here is `Knowledge Base`.
#             Keeping the prefix 404s on a folder that plainly exists.
#   item_id   the folder's Graph id. Preferred once known: survives renames.
#   share_url a sharing link Graph is asked to resolve, for a folder whose
#             drive nobody knows — content that arrived as a share. The link is
#             handed to Graph whole and encoded; the ids come back in Graph's
#             answer. Only reachable if the link points inside this tenant.
#   uri       optional. The folder's human-facing link, for status screens.
#             Never used to address Graph — an id is never derived from a URL.
#   enabled   optional, default true. false pauses a source without deleting
#             it, so its delta token survives and re-enabling resumes.
#
# Paste the URL from a browser's address bar to be told the entry to write —
# offline, no credentials needed:
#   cd backend && python -m scripts.discover_onedrive_sources --url "<url>"
# It reports the personal site name but deliberately will not turn it into an
# address: `a_b_c_com` could be a.b@c.com or a@b.c.com, and a guess would
# address somebody else's drive.
#
# Then pin folders to ids, which survive a rename, with:
#   cd backend && python -m scripts.discover_onedrive_sources --resolve
# which asks Graph where each folder is and prints the line to paste back.
#
# ONEDRIVE_SOURCES=[{"key":"knowledge-base","label":"Knowledge Base","user":"person@example.com","path":"Knowledge Base"},{"key":"capabilities","label":"Capabilities","path":"Capabilities"}]
ONEDRIVE_SOURCES=

# Files above this size are reported and skipped rather than downloaded.
# Empty means "use MAX_UPLOAD_SIZE_BYTES", so one ceiling applies however a
# document arrives.
ONEDRIVE_MAX_FILE_BYTES=
# Where a file is written while it is being ingested. Empty means the system
# temporary directory. Nothing is kept — OneDrive is never mirrored locally.
ONEDRIVE_STAGING_DIR=

# How many files are downloaded at once, and how many are staged before being
# ingested.
#
# Downloads are the only part of a sync safe to overlap — they touch the
# network and the staging directory and nothing else. Parsing, chunking,
# embedding and every database write stay on one thread with one SQLAlchemy
# session, which is not thread-safe.
#
# Four is deliberately modest: Graph throttles a first full sync hard, and the
# failure mode of too much concurrency is a storm of 429s that ends up slower
# than doing it serially. Raise it only with the per-source status in view.
ONEDRIVE_DOWNLOAD_CONCURRENCY=4
# The batch bounds two things: how much staging disk is in use, and how long a
# pre-authorised download URL sits unused before it is spent. Graph gives those
# URLs about an hour, so a run must never hold one longer than one batch takes.
ONEDRIVE_DOWNLOAD_BATCH_SIZE=16

# Periodic incremental sync, off unless switched on deliberately. With more
# than one worker process, every worker runs its own timer; see
# docs/KNOWN_ISSUES.md.
ONEDRIVE_SYNC_ENABLED=false
ONEDRIVE_SYNC_INTERVAL_SECONDS=3600

# --- Scheduled report digests ------------------------------------------------
# Snapshotting each user's last *completed* week and month of email, so a digest
# survives the mailbox provider ageing the messages out. Off by default for the
# same reason the sync is: it reads a third party's mailbox on a timer.
#
# The interval is a *check*, not a schedule. The job asks whether the last
# completed period has already been recorded and does nothing if it has, so
# running it hourly costs one indexed query per user per report type and no
# mailbox call at all. There is no cron expression because the boundaries are
# calendar arithmetic — ISO weeks and calendar months in UTC — not a crontab.
#
# With more than one worker process, every worker runs its own timer; the unique
# constraint on the report row makes that harmless. See docs/KNOWN_ISSUES.md.
REPORT_DIGEST_SCHEDULE_ENABLED=false
REPORT_DIGEST_INTERVAL_SECONDS=3600

# --- Administrator bootstrap --------------------------------------------------
# `is_admin` guards exactly one operation — deleting another person's Digital
# Twin — and no endpoint grants it. Without a bootstrap, a deployment with users
# and no administrator could never gain one.
#
# On startup, if nobody is an administrator, exactly one user is promoted and it
# is logged as a warning. This names which: the user with this email address.
# Leave it empty and the earliest-created user — the CEO, the first Digital Twin
# — is promoted instead. Nobody is ever demoted, no second person is promoted,
# and no user is ever created.
BOOTSTRAP_ADMIN_EMAIL=

# --- Email Agent ------------------------------------------------------------
#
# The Email Agent works with NO mailbox connected: composing, rewriting,
# templates, saved drafts and triage of a message you supply all function
# without any of the settings below. What needs a mailbox is listing an inbox
# and sending. Leaving EMAIL_PROVIDER empty is a supported state, not a broken
# one — and it is the honest one until Mail permissions have been granted.
#
# There is deliberately no simulated provider. With nothing configured, sending
# returns 409 and no draft is ever marked sent.

# "outlook", or empty for no mailbox.
EMAIL_PROVIDER=

# Per-user mailboxes replaced the single global one. Each person owns theirs
# through PUT /email/mailbox, stored in the `user_mailbox` table, and every
# email operation resolves it from the calling user. The two settings below are
# only the single-user fallback.
#
# The mailbox to act on, as a UPN or address — for example
# shared@sunradia.com. Required by the Outlook provider: a client-credentials
# token is the application acting as itself and carries no user, so every
# Graph mail call has to name whose mailbox it means.
EMAIL_MAILBOX_ADDRESS=

# Whether the address above is used for a person who has not connected their
# own mailbox. **OFF by default, and deliberately so.** With it on, every user
# of a multi-user deployment reads and sends through the same inbox — which is
# exactly the failure per-user mailboxes exist to remove. Leave it false unless
# the deployment genuinely has one user.
EMAIL_ALLOW_SHARED_FALLBACK_MAILBOX=false

# Outlook reuses the Entra application configured above for OneDrive
# (ONEDRIVE_TENANT_ID / _CLIENT_ID / _CLIENT_SECRET). One application, one
# token cache, one client — there is no second Graph authentication.
#
# But mail is a SEPARATE consent from files. On top of Files.Read.All, that
# application needs the APPLICATION permissions:
#   Mail.Read   — to list and read messages
#   Mail.Send   — to send on behalf of the mailbox
# with admin consent granted. Without them every mail call returns 403, and
# GET /email/provider/status will say so.

# Attachment limits. Attachment bytes are stored in the database row (see
# app/models/email.py), and these two are what keep that defensible.
EMAIL_MAX_ATTACHMENT_BYTES=10485760
EMAIL_MAX_ATTACHMENTS_PER_DRAFT=10

# How much retrieved company knowledge may be rendered into a generation
# prompt, and how many passages to retrieve. Smaller than the chat budget: an
# email is shorter than an answer, and a prompt stuffed with passages produces
# a message that reads like a document summary.
EMAIL_CONTEXT_MAX_CHARS=6000
EMAIL_RETRIEVAL_TOP_K=4

# How many messages one inbox page asks the provider for, and the most any one
# request may ask for. Fifty rather than twenty-five: twenty-five is under a
# screenful for anyone with real correspondence. The ceiling stops a client
# turning one request into a mailbox crawl — Graph will happily serve a
# thousand, and a request that large holds a worker open for as long as it takes.
EMAIL_INBOX_PAGE_SIZE=50
EMAIL_INBOX_MAX_PAGE_SIZE=200

# --- Tasks, the weekly report and escalation ------------------------------
# The thresholds the report's colours are decided by. Decided on the server so
# there is one copy: the frontend renders the verdict and never recomputes it
# from a date.

# How close a deadline must be before an open task shows amber. Compared
# against the due *timestamp*, not the date — "within three days" is 72 hours,
# and a date comparison would answer differently depending on the time of day.
TASK_WARNING_DAYS=3

# How long an overdue task may sit before the report asks for it to be
# escalated. Separate from the warning threshold because they answer different
# questions: one is "this needs doing soon", the other "this is not getting
# done".
TASK_ESCALATION_DAYS=7

# Who unresolved work is escalated to. Deliberately unset: with nothing here
# the report reads "Escalation target not identified" rather than guessing a
# recipient, which is the one thing an escalation workflow must never do. The
# counterparty on a task is never used as a fallback — they are usually the
# person who has not replied.
ESCALATION_CONTACT_ADDRESS=
ESCALATION_CONTACT_NAME=

# --- Deployment perimeter ------------------------------------------------
# Shared secret the reverse proxy (Vercel, frontend/vercel.json) adds to every
# request as the x-origin-secret header. When set, the API answers 403 to any
# request without it, except /health. Leave unset for local development.
# Generate one with: openssl rand -hex 32 — and set the same value in Vercel.
# This is not user authentication; X-User-ID is still trusted as sent.
# ORIGIN_SECRET=
